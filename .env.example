# HireMind AI Environment Configuration Example

# LLM Configuration
LLM_PROVIDER=groq                     # "groq" | "openai" | "anthropic" | "mistralai"
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hiremind

# Postgres Docker Credentials (if running docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hiremind
